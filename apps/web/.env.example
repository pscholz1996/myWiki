# Optional — legacy one-shot bootstrap for the knowledge-folder picker.
# The preferred way is the in-app welcome screen; your choice is saved to
# ~/.mywiki/config.json. If the config has no folder yet and this is set to
# an existing directory, it is used once and written into the config.
# PROJECT_DIR=""

# Optional — python of the Docling sidecar venv (auto-detected at
# tools/docling/.venv when present). MYWIKI_DISABLE_DOCLING=1 disables it.
# MYWIKI_DOCLING_PYTHON=""

# Required for the chat — the OpenAI-compatible LLM server that answers
# (vLLM, Ollama, LM Studio, …). Put the real address in .env.local, which is
# gitignored: an internal server address does not belong in a public repo.
# MYWIKI_LLM_BASE_URL="https://llm.example.internal:8080/v1"
# Optional — defaults to whatever model the server serves (/v1/models).
# MYWIKI_LLM_MODEL=""
# Optional — only if the server requires a key.
# MYWIKI_LLM_API_KEY=""

# Optional — the Claude model for visual work (figures from sources, own
# diagrams and graphics). Claude does nothing else in myWiki.
# MYWIKI_CLAUDE_VISUAL_MODEL="claude-opus-5-5"
