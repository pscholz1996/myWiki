{
  "name": "@mywiki/root",
  "description": "Local, AI-driven knowledge wiki over your own sources (papers, books, norms, slides)",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pscholz1996/myWiki"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm turbo dev",
    "dev:web": "pnpm turbo dev --filter=@mywiki/web",
    "lint": "pnpm exec biome check",
    "lint:fix": "pnpm exec biome check --fix",
    "setup:docling": "node tools/docling/setup.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "turbo": "^2.9.6"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
